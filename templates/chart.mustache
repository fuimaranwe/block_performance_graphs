{{!
    @template block_performance_graphs/chart

    Accessible chart container and filters.
}}
<section class="block-performance-graphs-card" aria-labelledby="{{element_id}}-title">
    <h3 id="{{element_id}}-title" class="sr-only">{{#str}}pluginname, block_performance_graphs{{/str}}</h3>

    <div class="chart-filters" data-blockid="{{block_id}}" data-courseid="{{current_course}}">
        {{#has_multiple_courses}}
        <div class="chart-filter">
            <label for="{{element_id}}-course-select">{{course_label}}</label>
            <select id="{{element_id}}-course-select" class="custom-select form-control">
                {{#courses}}
                <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>
                {{/courses}}
            </select>
        </div>
        {{/has_multiple_courses}}

        {{#is_student_mode}}
            {{#has_students}}
            <div class="chart-filter">
                <label for="{{element_id}}-student-select">{{student_label}}</label>
                <select id="{{element_id}}-student-select" class="custom-select form-control">
                    {{#students}}
                    <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>
                    {{/students}}
                </select>
            </div>
            {{/has_students}}
        {{/is_student_mode}}
    </div>

    <div class="chart-stat-callout" hidden>
        <div class="chart-stat-value" id="{{element_id}}-stat"></div>
        <div id="{{element_id}}-stat-label"></div>
    </div>

    <div id="{{element_id}}-loading" class="chart-loading" role="status" aria-live="polite" hidden>
        <span>{{loading_label}}</span>
    </div>
    <div id="{{element_id}}" class="performance-graph-container" aria-live="polite"></div>
</section>
